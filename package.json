{
  "name": "ptit-secure-envelope",
  "version": "1.0.0",
  "private": true,
  "description": "Thực nghiệm phong bì số giữa hai đơn vị bằng NestJS và node:crypto",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "start:dev": "node --env-file-if-exists=.env --watch -r ts-node/register src/main.ts",
    "test": "npm run build && node dist/scripts/run-tests.js",
    "demo": "npm run build && node dist/scripts/demo.js",
    "benchmark": "npm run build && node dist/scripts/benchmark.js",
    "report": "npm run build && node dist/scripts/report.js",
    "screenshots": "npm run build && node dist/scripts/screenshots.js",
    "lint": "tsc --noEmit",
    "format": "prettier --write src tests scripts README.md package.json tsconfig.json .prettierrc.json",
    "format:check": "prettier --check src tests scripts README.md package.json tsconfig.json .prettierrc.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "mongodb": "^7.8.0",
    "multer": "^2.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "chart.js": "^4.6.1",
    "docx": "^9.14.0",
    "playwright": "^1.64.1",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
