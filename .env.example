UNIT_ID=don-vi-a
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data/don-vi-a
MAX_FILE_SIZE_MB=10
TIMESTAMP_WINDOW_SECONDS=300
MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_DATABASE=ptit_envelope
# Mat khau khoa cua chinh don vi nhan, chi cau hinh trong .env cuc bo.
# RECEIVE_KEY_PASSPHRASE=replace-with-your-local-password

# Docker Compose: cong tren may host; cong ben trong hai container deu la 3000.
UNIT_A_PORT=3000
UNIT_B_PORT=3001
MONGO_PORT=27018
DOCKER_MONGODB_DATABASE=ptit_envelope_docker
# Neu dung POST /api/envelopes/receive, bo comment va dung dung mat khau luc sinh khoa cua tung don vi.
# UNIT_A_RECEIVE_KEY_PASSPHRASE=replace-with-unit-a-key-password
# UNIT_B_RECEIVE_KEY_PASSPHRASE=replace-with-unit-b-key-password
